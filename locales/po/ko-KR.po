msgid "Sequence"
msgstr "순서"

#: setup.php
msgid "Sequence of Item."
msgstr "항목의 순서."

#: setup.php
msgid "General Site Settings"
msgstr "일반 설정"

#: setup.php
msgid "Please enter a reasonable name for this site."
msgstr "이 사이트의 합당한 이름을 입력하십시오."

#: setup.php
msgid "Primary Customer Contact"
msgstr "기본 고객 연락처"

#: setup.php
msgid "The principal customer contact name and number for this site."
msgstr "이 사이트의 주요 고객 연락처 이름 및 번호."

#: setup.php
msgid "NetOps Contact"
msgstr "NetOps 연락처"

#: setup.php
msgid "Please principal network support contact name and number for this site."
msgstr "이 사이트의 주요 네트워크 지원 담당자 이름과 번호를 기재하십시오."

#: setup.php
msgid "Facilities Contact"
msgstr "시설 연락처"

#: setup.php
msgid "Please principal facilities/security contact name and number for this site."
msgstr "이 사이트의 주요 시설 / 보안 담당자 이름과 번호를 기입하십시오."

#: setup.php
msgid "Site Information"
msgstr "사이트 정보"

#: setup.php
msgid "Provide any site-specific information, in free form, that allows you to better manage this location."
msgstr "이 위치를 더 잘 관리 할 수있는 사이트 별 정보를 자유 형식으로 제공하십시오."

#: setup.php
msgid "General Mac Address Tracking Settings"
msgstr "일반 Mac 주소 추적 설정"

#: setup.php
msgid "MAC Address"
msgstr "MAC 주소"

#: setup.php
msgid "Please enter the MAC Address to be watched for."
msgstr "감시 할 MAC 주소를 입력하십시오."

#: setup.php
msgid "MAC Tracking Name/Email Subject"
msgstr "MAC 추적 이름 / 전자 메일 제목"

#: setup.php
msgid "Please enter a reasonable name for this MAC Tracking entry.  This information will be in the subject line of your Email"
msgstr "이 MAC 추적 항목의 합리적인 이름을 입력하십시오. 이 정보는 이메일의 제목란에 있습니다"

#: setup.php
msgid "Ticket number for cross referencing with your corporate help desk system(s)."
msgstr "회사 헬프 데스크 시스템과 상호 참조 할 수있는 티켓 번호입니다."

#: setup.php
msgid "Notification Schedule"
msgstr "통지 일정"

#: setup.php
msgid "Choose how often an Email should be generated for this Mac Watch item."
msgstr "이 Mac Watch 항목에 대해 이메일 생성 빈도를 선택하십시오."

#: setup.php
msgid "First Occurrence Only"
msgstr "첫 번째 발생 만"

#: setup.php
msgid "All Occurrences"
msgstr "모든 발생"

#: setup.php
msgid "Every Hour"
msgstr "매시간"

#: setup.php
msgid "Email Addresses"
msgstr "이메일 주소"

#: setup.php
msgid "Enter a semicolon separated of Email addresses that will be notified where this MAC address is."
msgstr "이 MAC 주소가있는 곳으로 통보 될 전자 메일 주소로 구분 된 세미콜론을 입력하십시오."

#: setup.php
msgid "General Mac Address Authorization Settings"
msgstr "일반 Mac 주소 권한 부여 설정"

#: setup.php
msgid "MAC Address Match"
msgstr "MAC 주소 일치"

#: setup.php
msgid "Please enter the MAC Address or Mac Address Match string to be automatically authorized.  If you wish to authorize a group of MAC Addresses, you can use the wildcard character of '&#37;' anywhere in the MAC Address."
msgstr "자동 승인을 받으려면 MAC 주소 또는 MAC 주소 일치 문자열을 입력하십시오. MAC 주소 그룹을 인증하려면 MAC 주소에서 와일드 카드 문자 '%'를 사용할 수 있습니다."

