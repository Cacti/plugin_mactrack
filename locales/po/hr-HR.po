msgstr "Redoslijed stavke."

#: setup.php
msgid "General Site Settings"
msgstr "Opće postavke lokacije"

#: setup.php
msgid "Please enter a reasonable name for this site."
msgstr "Unesite smisleni naziv za ovu lokaciju."

#: setup.php
msgid "Primary Customer Contact"
msgstr "Primarni kontakt korisnika"

#: setup.php
msgid "The principal customer contact name and number for this site."
msgstr "Ime i broj glavnog kontakta korisnika za ovu lokaciju."

#: setup.php
msgid "NetOps Contact"
msgstr "NetOps kontakt"

#: setup.php
msgid "Please principal network support contact name and number for this site."
msgstr "Unesite ime i broj glavnog kontakta mrežne podrške za ovu lokaciju."

#: setup.php
msgid "Facilities Contact"
msgstr "Kontakt za objekte"

#: setup.php
msgid "Please principal facilities/security contact name and number for this site."
msgstr "Unesite ime i broj glavnog kontakta za objekte/sigurnost za ovu lokaciju."

#: setup.php
msgid "Site Information"
msgstr "Podaci o lokaciji"

#: setup.php
msgid "Provide any site-specific information, in free form, that allows you to better manage this location."
msgstr "Navedite bilo kakve podatke specifične za lokaciju, u slobodnom obliku, koji vam omogućuju bolje upravljanje ovom lokacijom."

#: setup.php
msgid "General Mac Address Tracking Settings"
msgstr "Opće postavke praćenja MAC adresa"

#: setup.php
msgid "MAC Address"
msgstr "MAC adresa"

#: setup.php
msgid "Please enter the MAC Address to be watched for."
msgstr "Unesite MAC adresu koju treba pratiti."

#: setup.php
msgid "MAC Tracking Name/Email Subject"
msgstr "Naziv praćenja MAC adrese/predmet e-pošte"

#: setup.php
msgid "Please enter a reasonable name for this MAC Tracking entry.  This information will be in the subject line of your Email"
msgstr "Unesite smisleni naziv za ovaj unos praćenja MAC adrese. Taj će se podatak nalaziti u retku predmeta vaše poruke e-pošte"

#: setup.php
msgid "Ticket number for cross referencing with your corporate help desk system(s)."
msgstr "Broj zahtjeva za unakrsno povezivanje s vašim korporativnim sustavom/sustavima korisničke podrške."

#: setup.php
msgid "Notification Schedule"
msgstr "Raspored obavijesti"

#: setup.php
msgid "Choose how often an Email should be generated for this Mac Watch item."
msgstr "Odaberite koliko se često treba generirati poruka e-pošte za ovu stavku praćenja MAC adrese."

#: setup.php
msgid "First Occurrence Only"
msgstr "Samo prva pojava"

#: setup.php
msgid "All Occurrences"
msgstr "Sve pojave"

#: setup.php
msgid "Every Hour"
msgstr "Svaki sat"

#: setup.php
msgid "Email Addresses"
msgstr "Adrese e-pošte"

#: setup.php
msgid "Enter a semicolon separated of Email addresses that will be notified where this MAC address is."
msgstr "Unesite adrese e-pošte odvojene točkom sa zarezom koje će biti obaviještene o tome gdje se ova MAC adresa nalazi."

#: setup.php
msgid "General Mac Address Authorization Settings"
msgstr "Opće postavke autorizacije MAC adresa"

#: setup.php
msgid "MAC Address Match"
msgstr "Podudaranje MAC adrese"

#: setup.php
msgid "Please enter the MAC Address or Mac Address Match string to be automatically authorized.  If you wish to authorize a group of MAC Addresses, you can use the wildcard character of '&#37;' anywhere in the MAC Address."
msgstr "Unesite MAC adresu ili niz za podudaranje MAC adrese koji će biti automatski autoriziran. Ako želite autorizirati grupu MAC adresa, možete upotrijebiti zamjenski znak '&#37;' bilo gdje u MAC adresi."

#: setup.php
msgid "Please add a reason for this entry."
msgstr "Dodajte razlog za ovaj unos."
