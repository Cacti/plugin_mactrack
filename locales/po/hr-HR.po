#: lib/mactrack_partition_rebuild.php
msgid "The port, IP and 802.1x tables are being repartitioned, or a rebuild did not finish, so their history cannot be changed now. Try again when cli/upgrade_partitioning.php has finished."
msgstr "Tablice priključaka, IP adresa i 802.1x ponovno se particioniraju ili ponovna izgradnja nije dovršena, pa se njihova povijest sada ne može mijenjati. Pokušajte ponovno kada cli/upgrade_partitioning.php završi."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching while its history tables are repartitioned. Results are incomplete until the partitioning has finished."
msgstr "MacTrack je u načinu održavanja za pretraživanje IP adresa, MAC adresa i 802.1x dok se njegove tablice povijesti ponovno particioniraju. Rezultati su nepotpuni dok particioniranje ne završi."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching because the partitioning of its history tables did not finish. Results are incomplete. Run cli/upgrade_partitioning.php again to resume it."
msgstr "MacTrack je u načinu održavanja za pretraživanje IP adresa, MAC adresa i 802.1x jer particioniranje njegovih tablica povijesti nije dovršeno. Rezultati su nepotpuni. Pokrenite cli/upgrade_partitioning.php ponovno kako biste ga nastavili."

#: lib/mactrack_partition_rebuild.php
msgid "Maintenance Mode"
msgstr "Način održavanja"

