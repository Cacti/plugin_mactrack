#: lib/mactrack_partition_rebuild.php
msgid "The port, IP and 802.1x tables are being repartitioned, or a rebuild did not finish, so their history cannot be changed now. Try again when cli/upgrade_partitioning.php has finished."
msgstr "Amathebula embobo, e-IP kanye ne-802.1x ayahlukaniswa kabusha, noma ukwakha kabusha akuzange kuqede, ngakho-ke umlando wawo awukwazi ukushintshwa manje. Zama futhi uma i-cli/upgrade_partitioning.php isiqedile."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching while its history tables are repartitioned. Results are incomplete until the partitioning has finished."
msgstr "I-MacTrack isesimweni sokulungiswa ekusesheni ikheli le-IP, ikheli le-MAC ne-802.1x ngenkathi amathebula ayo omlando ehlukaniswa kabusha. Imiphumela ayiphelele kuze kube yilapho ukuhlukaniswa sekuphelile."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching because the partitioning of its history tables did not finish. Results are incomplete. Run cli/upgrade_partitioning.php again to resume it."
msgstr "I-MacTrack isesimweni sokulungiswa ekusesheni ikheli le-IP, ikheli le-MAC ne-802.1x ngoba ukuhlukaniswa kwamathebula ayo omlando akuphelanga. Imiphumela ayiphelele. Phinda uqhube cli/upgrade_partitioning.php ukuze uqhubeke."

#: lib/mactrack_partition_rebuild.php
msgid "Maintenance Mode"
msgstr "Imodi Yokulungisa"

