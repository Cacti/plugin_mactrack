msgstr " - SNMP V3: ім'я користувача SNMP"

#: mactrack_devices.php
msgid " - SNMP V3: SNMP password"
msgstr " - SNMP V3: пароль SNMP"

#: mactrack_devices.php
msgid " - SNMP V3: SNMP authentication protocol"
msgstr " - SNMP V3: протокол автентифікації SNMP"

#: mactrack_devices.php
msgid " - SNMP V3: SNMP privacy passphrase"
msgstr " - SNMP V3: парольна фраза конфіденційності SNMP"

#: mactrack_devices.php
msgid " - SNMP V3: SNMP privacy protocol"
msgstr " - SNMP V3: протокол конфіденційності SNMP"

#: mactrack_devices.php
msgid " - SNMP V3: SNMP context"
msgstr " - SNMP V3: контекст SNMP"

#: mactrack_devices.php
