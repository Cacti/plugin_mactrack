#: setup.php
msgid "General Mac Address Tracking Settings"
msgstr "Saitunan Bibiyar Adireshin MAC na Gabaɗaya"

#: setup.php
msgid "MAC Address"
msgstr "Adireshin MAC"

#: setup.php
msgid "Please enter the MAC Address to be watched for."
msgstr "Da fatan za a shigar da Adireshin MAC da za a kula da shi."

#: setup.php
msgid "MAC Tracking Name/Email Subject"
msgstr "Sunan Bin Diddigin MAC/Jigon Imel"

#: setup.php
msgid "Please enter a reasonable name for this MAC Tracking entry.  This information will be in the subject line of your Email"
msgstr "Da fatan za a shigar da suna mai ma'ana don wannan shigarwar Bibiyar MAC.  Wannan bayanin zai kasance a cikin layin jigon Imel ɗinka"

#: setup.php
msgid "Ticket number for cross referencing with your corporate help desk system(s)."
