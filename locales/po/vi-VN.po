#: setup.php:1608
msgid "General Mac Address Tracking Settings"
msgstr "Cài đặt theo dõi địa chỉ Mac chung"

#: setup.php:1613
msgid "Please enter the MAC Address to be watched for."
msgstr "Vui lòng nhập Địa chỉ MAC để được theo dõi."

#: setup.php:1620
msgid "MAC Tracking Name/Email Subject"
msgstr "Tên theo dõi MAC / Tiêu đề email"

#: setup.php:1621
msgid "Please enter a reasonable name for this MAC Tracking entry.  This information will be in the subject line of your Email"
msgstr "Vui lòng nhập tên hợp lý cho mục MAC Theo dõi này. Thông tin này sẽ có trong dòng chủ đề của Email của bạn"

#: setup.php:1640
msgid "Ticket number for cross referencing with your corporate help desk system(s)."
msgstr "Số vé để tham khảo chéo với (các) hệ thống bàn trợ giúp của công ty bạn."

#: setup.php:1647
msgid "Notification Schedule"
msgstr "Lịch trình thông báo"

#: setup.php:1648
msgid "Choose how often an Email should be generated for this Mac Watch item."
msgstr "Chọn tần suất tạo Email cho mục Mac Watch này."

#: setup.php:1652
msgid "First Occurrence Only"
msgstr "Lần xuất hiện đầu tiên"

#: setup.php:1653
msgid "All Occurrences"
msgstr "Tất cả các lần xuất hiện"

#: setup.php:1654
msgid "Every Hour"
msgstr "Mỗi tiếng"

#: setup.php:1661
msgid "Email Addresses"
msgstr "Địa chỉ Email"

#: setup.php:1662
msgid "Enter a semicolon separated of Email addresses that will be notified where this MAC address is."
msgstr "Nhập một dấu chấm phẩy được phân tách bằng các địa chỉ Email sẽ được thông báo nơi có địa chỉ MAC này."

#: setup.php:1685
msgid "General Mac Address Authorization Settings"
msgstr "Cài đặt ủy quyền địa chỉ Mac chung"

#: setup.php:1689
msgid "MAC Address Match"
msgstr "Kết hợp địa chỉ MAC"

#: setup.php:1690
msgid "Please enter the MAC Address or Mac Address Match string to be automatically authorized.  If you wish to authorize a group of MAC Addresses, you can use the wildcard character of '&#37;' anywhere in the MAC Address."
msgstr "Vui lòng nhập chuỗi Địa chỉ MAC hoặc Chuỗi Địa chỉ Mac để được ủy quyền tự động. Nếu bạn muốn ủy quyền cho một nhóm Địa chỉ MAC, bạn có thể sử dụng ký tự đại diện '%' ở bất cứ đâu trong Địa chỉ MAC."

