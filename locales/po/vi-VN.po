msgid "Are you sure you want to delete all the Port to MAC to IP results from the system?"
msgstr "Bạn có chắc chắn muốn xóa tất cả các kết quả từ Cổng sang MAC sang IP khỏi hệ thống không?"

#: lib/mactrack_functions.php
msgid "Are you sure you want to delete the expired Port to MAC to IP results now?"
msgstr "Bạn có chắc chắn muốn xóa các kết quả Cổng sang MAC sang IP đã hết hạn ngay bây giờ không?"

#: lib/mactrack_functions.php
msgid "Are you sure you want to purge the cached Mactrack scanning functions?"
msgstr "Bạn có chắc chắn muốn xóa bộ nhớ đệm các hàm quét của MacTrack không?"

#: lib/mactrack_functions.php
msgid "Are you sure you want to delete all the Aggregated Port to MAC to IP results from the system?"
msgstr "Bạn có chắc chắn muốn xóa tất cả các kết quả Cổng tổng hợp sang MAC sang IP khỏi hệ thống không?"

#: lib/mactrack_functions.php
msgid "Are you sure you want to delete and recreate all the Aggregated Port to MAC to IP results from the system?"
msgstr "Bạn có chắc chắn muốn xóa và tạo lại tất cả các kết quả Cổng tổng hợp sang MAC sang IP từ hệ thống không?"

#: lib/mactrack_functions.php
msgid "Are you sure you want to download and import the IEEE Vendor MAC/OUI database now?"
msgstr "Bạn có chắc chắn muốn tải xuống và nhập cơ sở dữ liệu IEEE Vendor MAC/OUI ngay bây giờ không?"

#: lib/mactrack_functions.php
msgid "Are you sure you want to rebuild the scan date list from the stored Port to MAC to IP results now?"
msgstr "Bạn có chắc chắn muốn tạo lại danh sách ngày quét từ các kết quả Cổng sang MAC sang IP đã lưu ngay bây giờ không?"

#: lib/mactrack_functions.php
msgid "Rebuild and analyze the partition containing the latest port observation, which is the current week with weekly partitions. An unpartitioned table is optimized in full. Scheduled scans are skipped while this runs. Continue?"
msgstr "Xây dựng lại và phân tích phân vùng chứa dữ liệu quan sát cổng mới nhất, tức là tuần hiện tại đối với các phân vùng theo tuần. Bảng chưa phân vùng sẽ được tối ưu hóa toàn bộ. Các lượt quét theo lịch trình sẽ bị bỏ qua trong khi tác vụ này chạy. Tiếp tục?"

#: lib/mactrack_functions.php
msgid "Run this maintenance off hours. The rebuild copies the full history of the port (MAC address), IP address and 802.1x tables one after the other and can take hours. Scheduled scans are skipped, database maintenance waits, and MAC, IP and 802.1x searching shows a maintenance message until it finishes. Allow free disk space for a second copy of each table and its indexes. Continue?"
msgstr "Hãy chạy bảo trì này ngoài giờ làm việc. Quá trình xây dựng lại sẽ sao chép toàn bộ lịch sử của các bảng cổng (địa chỉ MAC), địa chỉ IP và 802.1x lần lượt từng bảng một và có thể mất nhiều giờ. Các lượt quét theo lịch trình sẽ bị bỏ qua, bảo trì cơ sở dữ liệu sẽ chờ, và chức năng tìm kiếm MAC, IP và 802.1x sẽ hiển thị thông báo bảo trì cho đến khi hoàn tất. Cần đảm bảo dung lượng đĩa trống đủ cho bản sao thứ hai của mỗi bảng và các chỉ mục của nó. Tiếp tục?"

