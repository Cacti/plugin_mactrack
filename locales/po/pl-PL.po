#: lib/mactrack_partition_rebuild.php
msgid "The port, IP and 802.1x tables are being repartitioned, or a rebuild did not finish, so their history cannot be changed now. Try again when cli/upgrade_partitioning.php has finished."
msgstr "Tabele portów, IP i 802.1x są ponownie partycjonowane lub przebudowa nie została zakończona, więc nie można teraz zmienić ich historii. Spróbuj ponownie po zakończeniu cli/upgrade_partitioning.php."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching while its history tables are repartitioned. Results are incomplete until the partitioning has finished."
msgstr "MacTrack działa w trybie konserwacji dla wyszukiwania adresów IP, adresów MAC i 802.1x podczas ponownego partycjonowania tabel historii. Wyniki będą niepełne do czasu zakończenia partycjonowania."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching because the partitioning of its history tables did not finish. Results are incomplete. Run cli/upgrade_partitioning.php again to resume it."
msgstr "MacTrack działa w trybie konserwacji dla wyszukiwania adresów IP, adresów MAC i 802.1x, ponieważ partycjonowanie tabel historii nie zostało zakończone. Wyniki są niepełne. Uruchom ponownie cli/upgrade_partitioning.php, aby je wznowić."

#: lib/mactrack_partition_rebuild.php
msgid "Maintenance Mode"
msgstr "Tryb konserwacji"

