#: lib/mactrack_partition_rebuild.php
msgid "The port, IP and 802.1x tables are being repartitioned, or a rebuild did not finish, so their history cannot be changed now. Try again when cli/upgrade_partitioning.php has finished."
msgstr "Iitafile zezibuko, i-IP kunye ne-802.1x ziyahlulwahlulwa kwakhona, okanye ukwakhiwa kwakhona akugqitywanga, ngoko ke imbali yazo ayinakutshintshwa ngoku. Zama kwakhona xa i-cli/upgrade_partitioning.php igqibile."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching while its history tables are repartitioned. Results are incomplete until the partitioning has finished."
msgstr "I-MacTrack ikwimo yolondolozo yokukhangela idilesi ye-IP, idilesi ye-MAC kunye ne-802.1x ngelixa iitheyibhile zembali yayo zahlulwa kwakhona. Iziphumo aziphelelanga de ukwahlulwa kugqitywe."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching because the partitioning of its history tables did not finish. Results are incomplete. Run cli/upgrade_partitioning.php again to resume it."
msgstr "I-MacTrack ikwimo yolondolozo yokukhangela idilesi ye-IP, idilesi ye-MAC kunye ne-802.1x kuba ukwahlulwa kweetheyibhile zembali yayo akugqitywanga. Iziphumo aziphelelanga. Qhuba i-cli/upgrade_partitioning.php kwakhona ukuze uqhube."

#: lib/mactrack_partition_rebuild.php
msgid "Maintenance Mode"
msgstr "Imowudi yoLondolozo"

