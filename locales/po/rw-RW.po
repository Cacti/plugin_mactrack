#: lib/mactrack_partition_rebuild.php
msgid "The port, IP and 802.1x tables are being repartitioned, or a rebuild did not finish, so their history cannot be changed now. Try again when cli/upgrade_partitioning.php has finished."
msgstr "Imbonerahamwe z'umuyoboro, IP na 802.1x ziri kongera kugabanywamo ibice, cyangwa isanwa ntiryarangiye, bityo amateka yazo ntashobora guhindurwa ubu. Ongera ugerageze igihe cli/upgrade_partitioning.php irangije."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching while its history tables are repartitioned. Results are incomplete until the partitioning has finished."
msgstr "MacTrack iri mu buryo bw'isanwa ku gushakisha aderesi ya IP, aderesi ya MAC na 802.1x mu gihe imbonerahamwe z'amateka yayo ziri kugabanywa bundi bushya. Ibisubizo ntibyuzuye kugeza igihe ugabanya birangiye."

#: lib/mactrack_partition_rebuild.php
msgid "MacTrack is in maintenance mode for IP address, MAC address and 802.1x searching because the partitioning of its history tables did not finish. Results are incomplete. Run cli/upgrade_partitioning.php again to resume it."
msgstr "MacTrack iri mu buryo bw'isanwa ku gushakisha aderesi ya IP, aderesi ya MAC na 802.1x kuko kugabanya imbonerahamwe z'amateka yayo bitarangiye. Ibisubizo ntibyuzuye. Ongera ukoreshe cli/upgrade_partitioning.php kugira ngo ubikomeze."

#: lib/mactrack_partition_rebuild.php
msgid "Maintenance Mode"
msgstr "Uburyo bwo Kubungabunga"

