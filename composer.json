{
  "name": "cacti/plugin-mactrack",
  "description": "MacTrack plugin for Cacti - tooling helpers",
  "type": "library",
  "require": {},
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "jakub-onderka/php-parallel-lint": "^1.0"
  },
  "scripts": {
    "phpcsfixer": "vendor/bin/php-cs-fixer fix",
    "lint": "vendor/bin/parallel-lint --exclude include/vendor ./cacti/plugins/mactrack"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
