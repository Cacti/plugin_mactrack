{
    "name": "cacti/plugin-mactrack",
    "description": "Cacti Mactrack plugin test tooling",
    "type": "cacti-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "vimeo/psalm": "^5"
    },
    "scripts": {
        "test": "php tests/run.php all",
        "test:unit": "php tests/run.php unit",
        "test:integration": "php tests/run.php integration",
        "test:security": "php tests/run.php security",
        "test:e2e:static": "php tests/run.php e2e-static",
        "analyse": "psalm --no-progress"
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        },
        "sort-packages": true
    },
    "require": {
        "mikepultz/netdns2": "^1.5"
    }
}
